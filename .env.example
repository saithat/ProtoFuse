# Copy to .env and fill in values. Never commit .env.
#
#   cp .env.example .env
#
# Get keys from the GXL hackathon organizer email / partner dashboards.
# Docs: docs/SETUP.md and docs/PARTNER_RESOURCES.md

# -----------------------------------------------------------------------------
# Required for Phillip paper → methodology extraction (Anthropic backend)
# https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional model override for `protofuse extract` and methodology agents.
PROTOFUSE_ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Paperclip — paper search, full text, figures (Phillip ingestion)
# https://paperclip.gxl.ai/docs
#
# Option A (scripts / CI): paste a dashboard API key here.
# Option B (interactive): run `paperclip login` instead; OAuth creds live in
# ~/.paperclip/credentials.json and this var can stay empty.
PAPERCLIP_API_KEY=

# -----------------------------------------------------------------------------
# Modal — GPU execution for Proto tools (RFdiffusion3, Boltz-2, etc.)
# Run once: `uv run modal setup` (writes ~/.modal.toml; not this file).
# Set to your Modal environment name (dashboard → Environments). Default in
# proto-tools is `proto-env`; many workspaces use `main`.
MODAL_ENVIRONMENT=main
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Hugging Face — only if a selected Proto model requires a gated checkpoint
# https://huggingface.co/settings/tokens
HF_TOKEN=

# -----------------------------------------------------------------------------
# Optional Proto runtime paths (defaults are fine for most hackathon work)
PROTO_HOME=
PROTO_MODEL_CACHE=
