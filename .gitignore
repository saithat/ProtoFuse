.DS_Store
.env
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Papers and generated runs can be large or confidential. Keep only examples.
data/papers/*
!data/papers/.gitkeep
data/specs/*
!data/specs/.gitkeep
data/runs/*
!data/runs/.gitkeep
data/analysis/*
!data/analysis/.gitkeep
data/models/*
!data/models/.gitkeep

# Reviewed, compact visualization exports are publication artifacts, not raw run data.
!data/visualizations/
!data/visualizations/**

# Raw benchmark invocations are run outputs; only the merged rollup markdown is tracked.
workspaces/phillip/benchmark_runs/*
!workspaces/phillip/benchmark_runs/.gitkeep
workspaces/phillip/PIPELINE_BENCHMARKS.json

# Proto model/tool caches belong outside Git.
.proto/

# Local agent skill bundles and deployment logs are machine-specific tooling/output.
.agents/
logs/

# Per-contributor local agent instructions stay out of the shared repo.
AGENTS.local.md
**/AGENTS.local.md
