--- a/src/alphafold3/model/network/evoformer.py
+++ b/src/alphafold3/model/network/evoformer.py
@@ -27,6 +27,16 @@ import jax
 import jax.numpy as jnp
 
 
+def _scale_pairformer_input(
+    pair_activations: jnp.ndarray, beta: float
+) -> jnp.ndarray:
+  """Scales the complete pair representation immediately before Pairformer."""
+  if beta == 0.0:
+    return pair_activations
+  factor = jnp.asarray(1.0 + beta, dtype=pair_activations.dtype)
+  return pair_activations * factor
+
