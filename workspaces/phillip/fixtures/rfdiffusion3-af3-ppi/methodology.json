  "workflow": {
    "steps": [
      {
        "id": "generate_backbones",
        "operation": "RFdiffusion3 target-conditioned binder backbone generation",
        "inputs": ["target_structure", "hotspots", "binder_length"],
        "outputs": ["binder_backbones"],
        "parameters": {"backbones_per_target": 400},
        "evidence": []
      },
      {
        "id": "inverse_fold",
        "operation": "ProteinMPNN sequence sampling and probability scoring",
        "inputs": ["binder_backbones"],
        "outputs": ["binder_sequences", "proteinmpnn_probability_loss"],
        "parameters": {"sequences_per_backbone": 4},
        "evidence": []
      },
      {
        "id": "predict_complex",
        "operation": "AlphaFold3 binder-target complex prediction",
        "inputs": ["binder_sequences", "target_sequence"],
        "outputs": ["predicted_complexes"],
        "parameters": {},
        "evidence": []
      },
      {
        "id": "score_joint_objectives",
        "operation": "Persist ProteinMPNN, AlphaFold3 interface-confidence, and PAE objectives plus paper endpoints",
        "inputs": ["proteinmpnn_probability_loss", "predicted_complexes"],
        "outputs": ["objective_vectors", "paper_success_flags"],
        "parameters": {},
        "evidence": []
      }
    ],
    "edges": [
      {"source": "generate_backbones", "target": "inverse_fold", "artifact": "binder_backbones"},
      {"source": "inverse_fold", "target": "predict_complex", "artifact": "binder_sequences"},
      {"source": "inverse_fold", "target": "score_joint_objectives", "artifact": "proteinmpnn_probability_loss"},
      {"source": "predict_complex", "target": "score_joint_objectives", "artifact": "predicted_complexes"}
    ]
  },
  "selection_thresholds": [
    {
      "name": "minimum interchain pAE",
      "metric": "minimum_interchain_pae",
      "operator": "<=",
      "value": 1.5,
      "unit": "angstrom-like PAE score",
      "applies_to": "AlphaFold3 binder-target prediction",
      "evidence": [{"quote": "minimum interchain pAE <= 1.5", "section": "PPI benchmark success criteria"}]
    },
    {
      "name": "binder pTM",
      "metric": "binder_ptm",
      "operator": ">=",
      "value": 0.8,
      "unit": "score",
      "applies_to": "AlphaFold3 binder chain",
      "evidence": [{"quote": "binder pTM >= 0.8", "section": "PPI benchmark success criteria"}]
    },
    {
      "name": "binder RMSD",
      "metric": "target_aligned_binder_ca_rmsd",
      "operator": "<",
      "value": 2.5,
      "unit": "angstrom",
      "applies_to": "target-aligned designed versus predicted binder",
      "evidence": [{"quote": "target-aligned binder C-alpha RMSD < 2.5 Angstrom", "section": "PPI benchmark success criteria"}]
    }
  ],
