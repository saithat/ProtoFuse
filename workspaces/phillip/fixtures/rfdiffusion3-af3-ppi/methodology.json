{
  "schema_version": "1.0",
  "paper": {
    "title": "De novo Design of All-atom Biomolecular Interactions with RFdiffusion3",
    "identifier": "10.1101/2025.09.18.676967",
    "source_path": null
  },
  "generators": [
    {
      "name": "RFdiffusion3 PPI backbone generation",
      "description": "Generate target-conditioned binder backbones and sample four ProteinMPNN sequences per backbone.",
      "parameters": {
        "backbones_per_target": 400,
        "sequences_per_backbone": 4,
        "targets": 5
      },
      "evidence": [
        {
          "quote": "For each target, we generated 400 RFdiffusion3 and RFdiffusion2 designs. For each backbone, we design 4 sequences using ProteinMPNN.",
          "section": "PPI benchmark methods"
        }
      ],
      "output": "protein"
    }
  ],
  "constraints": [
    {
      "name": "ProteinMPNN inverse folding probability",
      "description": "Retain the ProteinMPNN sequence probability loss as its own surrogate target rather than folding it into the AlphaFold3 scores.",
      "parameters": {
        "model": "proteinmpnn",
        "score_mode": "probability_loss",
        "sequences_per_backbone": 4
      },
      "evidence": [
        {
          "quote": "For each backbone, we design 4 sequences using ProteinMPNN.",
          "section": "PPI benchmark methods"
        }
      ],
      "metric": "proteinmpnn_probability_loss",
      "direction": "minimize",
      "weight": 1.0
    },
    {
      "name": "AlphaFold3 interface confidence proxy",
      "description": "Record Proto's 1-ipTM score separately. This is a surrogate-friendly proxy and not the paper's binder-pTM endpoint.",
      "parameters": {
        "structure_tool": "alphafold3",
        "paper_endpoint": "binder_pTM >= 0.8"
      },
      "evidence": [
        {
          "quote": "binder pTM >= 0.8",
          "section": "PPI benchmark success criteria"
        }
      ],
      "metric": "one_minus_iptm_proxy",
      "direction": "minimize",
      "weight": 1.0
    },
    {
      "name": "AlphaFold3 mean PAE proxy",
      "description": "Record Proto's normalized mean full-complex PAE separately. It must not be compared directly with the paper's minimum interchain pAE threshold.",
      "parameters": {
        "structure_tool": "alphafold3",
        "paper_endpoint": "minimum_interchain_pAE <= 1.5"
      },
      "evidence": [
        {
          "quote": "minimum interchain pAE <= 1.5",
          "section": "PPI benchmark success criteria"
        }
      ],
      "metric": "normalized_mean_full_pae_proxy",
      "direction": "minimize",
      "weight": 1.0
    },
    {
      "name": "protein length range",
      "description": "Keep each prototype binder at a fixed length chosen inside the paper's target-specific allowed interval.",
      "parameters": {
        "paper_ranges_aa": [[50, 120], [40, 120], [50, 120], [65, 120], [65, 120]]
      },
      "evidence": [
        {
          "quote": "We varied the length of the designed chain uniformly in the ranges listed in Table S4.",
          "section": "PPI benchmark methods"
        }
      ],
      "metric": "binder_length",
      "direction": "range",
      "weight": 1.0
    }
  ],
  "optimizers": [
    {
      "name": "rejection sampling PPI benchmark",
      "description": "Enumerate 1,600 sequence candidates per target and retain their named per-model scores for later scalar or vector surrogate experiments.",
      "parameters": {
        "num_samples": 1600,
        "num_results": 1600
      },
      "evidence": [
        {
          "quote": "For each target, we generated 400 RFdiffusion3 and RFdiffusion2 designs. For each backbone, we design 4 sequences using ProteinMPNN.",
          "section": "PPI benchmark methods"
        }
      ],
      "strategy": "rejection_sampling",
      "stopping_criteria": {
        "num_samples": 1600,
        "num_results": 1600
      }
    }
  ],
  "model_dependencies": [
    {
      "name": "RFdiffusion3",
      "version_or_checkpoint": null,
      "provider": "Baker Lab / IPD",
      "purpose": "All-atom target-conditioned binder backbone generation",
      "evidence": [
        {
          "quote": "RFdiffusion3 directly generates all-atom biomolecular structures.",
          "section": "Abstract"
        }
      ]
    },
    {
      "name": "ProteinMPNN",
