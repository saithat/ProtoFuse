      "provider": "Dauparas et al.",
      "purpose": "Four inverse-folded sequences per generated backbone",
      "evidence": [
        {
          "quote": "For each backbone, we design 4 sequences using ProteinMPNN.",
          "section": "PPI benchmark methods"
        }
      ]
    },
    {
      "name": "AlphaFold3",
      "version_or_checkpoint": null,
      "provider": "Google DeepMind",
      "purpose": "Binder-target complex validation",
      "evidence": [
        {
          "quote": "We evaluate each sequence using AlphaFold3.",
          "section": "PPI benchmark methods"
        }
      ]
    }
  ],
