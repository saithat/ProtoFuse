      "weight": 1.0
    }
  ],
  "optimizers": [
    {
      "name": "MCMC refinement",
      "description": "Region-local LigandMPNN mutations within the active site.",
      "parameters": {"num_steps": 100, "num_results": 1},
      "evidence": [
        {
          "quote": "Topology: cycling or region-local MCMC on active-site segment.",
